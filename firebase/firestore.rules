rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Público pode ler participantes e registros
    match /participantes/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /registros/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
